{
  "name": "monopoly-io-game",
  "version": "0.1.0",
  "private": true,
  "description": "大富翁.io - 多人在线网页大富翁游戏",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev-services.mjs",
    "build:shared": "cd packages/shared && npm run build",
    "build:server": "cd packages/server && npm run build",
    "build:client": "cd packages/client && npm run build",
    "build:admin": "cd packages/admin && npm run build",
    "dev:server": "cd packages/server && npm run dev",
    "dev:client": "cd packages/client && npm run dev",
    "dev:admin": "cd packages/admin && npm run dev",
    "lint": "cd packages/shared && npm run lint && cd ../../packages/server && npm run lint && cd ../../packages/client && npm run lint",
    "test": "cd packages/shared && npm test && cd ../../packages/server && npm test && cd ../../packages/client && npm test",
    "clean": "rm -rf node_modules packages/*/node_modules packages/*/dist packages/*/coverage"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
