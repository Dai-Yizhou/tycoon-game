    "region": {
      "background": {
        "$value": "repeating-linear-gradient(91deg, rgba(60,51,38,0.06) 0 1px, transparent 1px 8px), repeating-linear-gradient(0deg, rgba(60,51,38,0.04) 0 1px, transparent 1px 5px)",
        "$type": "string"
      }
    }
  },
  "font": {
    "body": {
      "$value": "'Kaiti SC', 'STKaiti', KaiTi, 'Noto Serif SC', serif",
      "$type": "fontFamily"
    },
    "title": {
      "$value": "'Kaiti SC', 'STKaiti', KaiTi, 'Noto Serif SC', Georgia, serif",
      "$type": "fontFamily"
    },
    "func": {
      "$value": "Georgia, serif",
      "$type": "fontFamily"
    },
    "number": {
      "$value": "Georgia, 'Times New Roman', serif",
      "$type": "fontFamily"
    },
    "titleWeight": {
      "$value": 700,
      "$type": "number"
