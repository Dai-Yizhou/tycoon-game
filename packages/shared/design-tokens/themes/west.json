    "pieceSpan": {
      "$value": 14,
      "$type": "number"
    },
    "pieceDy": {
      "$value": 3,
      "$type": "number"
    },
    "pieceAlphaDay": {
      "$value": 0.5,
      "$type": "number"
    },
    "pieceAlphaNight": {
      "$value": 0.22,
      "$type": "number"
