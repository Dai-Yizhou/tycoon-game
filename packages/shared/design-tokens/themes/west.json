    "region": {
      "background": {
        "$value": "repeating-linear-gradient(90deg, rgba(61,46,44,0.06) 0 1px, transparent 1px 4px), repeating-linear-gradient(0deg, rgba(61,46,44,0.06) 0 1px, transparent 1px 4px)",
        "$type": "string"
      }
    }
  },
  "font": {
    "body": {
      "$value": "Noto Sans SC, PingFang SC, sans-serif",
      "$type": "fontFamily"
    },
    "title": {
      "$value": "'Times New Roman', Georgia, serif",
      "$type": "fontFamily"
    },
    "func": {
      "$value": "'PingFang SC', 'Heiti SC', 'STHeiti', 'Microsoft YaHei', sans-serif",
      "$type": "fontFamily"
    },
    "number": {
      "$value": "IBM Plex Mono, Menlo, monospace",
      "$type": "fontFamily"
    }
