  "motion": {
    "fast": { "$value": "0.15s ease", "$type": "string" },
    "normal": { "$value": "0.25s ease", "$type": "string" },
    "step": { "$value": 280, "$type": "number" },
    "stepArrive": { "$value": 220, "$type": "number" },
    "moveComplete": { "$value": 320, "$type": "number" },
    "diceSettled": { "$value": 400, "$type": "number" },
    "propertyBought": { "$value": 600, "$type": "number" },
    "bankrupt": { "$value": 1000, "$type": "number" },
    "slideUpTitle": { "$value": "0.6s", "$type": "string" },
    "slideUp": { "$value": "0.4s", "$type": "string" },
    "spin": { "$value": "1s", "$type": "string" },
    "hover": { "$value": 160, "$type": "number" },
    "bounce": { "$value": "2s ease-in-out", "$type": "string" },
    "transition": { "$value": "0.5s", "$type": "string" }
  },
  "dimension": {
    "piece": {
      "outline": {
        "$value": 3,
        "$type": "number"
      }
    },
    "line": {
      "map": {
        "$value": 10,
        "$type": "number"
      },
      "current": {
        "$value": 3,
        "$type": "number"
      }
    }
  },
  "texture": {
    "region": {
      "background": {
        "$value": "repeating-linear-gradient(90deg, rgba(61,46,44,0.06) 0 1px, transparent 1px 4px), repeating-linear-gradient(0deg, rgba(61,46,44,0.06) 0 1px, transparent 1px 4px)",
        "$type": "string"
      }
    }
  },
  "font": {
    "body": {
      "$value": "'Songti SC', SimSun, 'Noto Serif SC', serif",
      "$type": "fontFamily"
    },
    "title": {
      "$value": "'Courier New', 'Songti SC', SimSun, 'Noto Serif SC', serif",
      "$type": "fontFamily"
    },
    "func": {
      "$value": "'PingFang SC', 'Heiti SC', 'STHeiti', 'Microsoft YaHei', sans-serif",
      "$type": "fontFamily"
    },
    "number": {
      "$value": "'Courier New', monospace",
      "$type": "fontFamily"
    },
    "titleWeight": {
      "$value": 900,
      "$type": "number"
    },
    "titleSpacing": {
      "$value": "0.01em",
      "$type": "string"
    },
    "bodySpacing": {
      "$value": "0.02em",
      "$type": "string"
    },
    "titleLineHeight": {
      "$value": 1.3,
      "$type": "number"
    }
  },
