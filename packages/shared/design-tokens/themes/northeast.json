{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "palette": {
      "surface": {
        "$value": "#E4D9C8",
        "$type": "color"
      },
      "border": {
        "$value": "#4A2C2A",
        "$type": "color"
      },
      "accent": {
        "$value": "#D95A2B",
        "$type": "color"
      },
      "property": {
        "$value": "#4F6D5E",
        "$type": "color"
      },
      "event": {
        "$value": "#D95A2B",
        "$type": "color"
      },
      "transport": {
        "$value": "#4A2C2A",
        "$type": "color"
      }
    },
    "surface": {
      "board": {
        "$value": "{color.palette.surface}",
        "$type": "color"
      }
    },
    "cell": {
      "property": {
        "fill": {
          "$value": "{color.palette.property}",
          "$type": "color"
        }
      },
      "event": {
        "fill": {
          "$value": "{color.palette.event}",
          "$type": "color"
        }
      },
      "transport": {
        "fill": {
          "$value": "{color.palette.transport}",
          "$type": "color"
        }
      }
    },
    "piece": {
      "head": {
        "$value": "#F3D68A",
        "$type": "color"
      },
      "outline": {
        "$value": "#1A1A1A",
        "$type": "color"
      }
    },
    "player": {
      "self": {
        "$value": "#C0392B",
        "$type": "color"
      },
      "teammate": {
        "$value": "#2C5F8D",
        "$type": "color"
      },
      "other": {
        "$value": "#4A7C3F",
        "$type": "color"
      }
    },
    "line": {
      "map": {
        "$value": "#B0B0B0",
        "$type": "color"
      }
    },
    "hud": {
      "barBg": {
        "$value": "#1E2024",
        "$type": "color"
      },
      "sidebarBg": {
        "$value": "#252830",
        "$type": "color"
      },
      "mapBg": {
        "$value": "#1A1C1F",
        "$type": "color"
      },
      "card": {
        "$value": "#34373D",
        "$type": "color"
      },
      "fg": {
        "$value": "#E6DCC3",
        "$type": "color"
      },
      "muted": {
        "$value": "#9AA0A6",
        "$type": "color"
      },
      "cellBg": {
        "$value": "#2C2F35",
        "$type": "color"
      },
      "cellBorder": {
        "$value": "{color.palette.border}",
        "$type": "color"
      }
    },
    "region": {
      "board": {
        "$value": "#2C2E33",
        "$type": "color"
      },
      "fg": {
        "$value": "#E6DCC3",
        "$type": "color"
      },
      "border": {
        "$value": "#4A2C2A",
        "$type": "color"
      },
      "borderWidth": {
        "$value": 1,
        "$type": "number"
      },
      "radius": {
        "$value": 1,
        "$type": "number"
      },
      "accent": {
        "$value": "#D95A2B",
        "$type": "color"
      },
      "accentHover": {
        "$value": "#EF6A36",
        "$type": "color"
      },
      "labelFg": {
        "$value": "#9AA0A6",
        "$type": "color"
      },
      "motionFg": {
        "$value": "#C9A98A",
        "$type": "color"
      },
      "ruleColor": {
        "$value": "rgba(230,220,195,0.22)",
        "$type": "color"
      },
      "cellBg": {
        "$value": "#34373D",
        "$type": "color"
      },
      "cellBorder": {
        "$value": "#4A2C2A",
        "$type": "color"
      },
      "boxBg": {
        "$value": "#34373D",
        "$type": "color"
      },
      "btnFg": {
        "$value": "#FBF8F1",
        "$type": "color"
      },
      "cycleDay": {
        "$value": "#E8C84A",
        "$type": "color"
      },
      "cycleNight": {
        "$value": "#3A4A6B",
        "$type": "color"
      },
      "error": {
        "$value": "#C0392B",
        "$type": "color"
      }
    }
  },
  "motion": {
    "fast": { "$value": "0.15s ease", "$type": "string" },
    "normal": { "$value": "0.25s ease", "$type": "string" },
    "step": { "$value": 280, "$type": "number" },
    "stepArrive": { "$value": 220, "$type": "number" },
    "moveComplete": { "$value": 320, "$type": "number" },
    "diceSettled": { "$value": 400, "$type": "number" },
    "propertyBought": { "$value": 600, "$type": "number" },
    "bankrupt": { "$value": 1000, "$type": "number" },
    "slideUpTitle": { "$value": "0.6s", "$type": "string" },
    "slideUp": { "$value": "0.4s", "$type": "string" },
    "spin": { "$value": "1s", "$type": "string" },
    "hover": { "$value": 160, "$type": "number" },
    "bounce": { "$value": "2s ease-in-out", "$type": "string" },
    "transition": { "$value": "0.5s", "$type": "string" }
  },
  "dimension": {
    "piece": {
      "outline": {
        "$value": 3,
        "$type": "number"
      }
    },
    "line": {
      "map": {
        "$value": 10,
        "$type": "number"
      },
      "current": {
        "$value": 3,
        "$type": "number"
      }
    }
  },
  "texture": {
    "region": {
      "background": {
        "$value": "repeating-linear-gradient(90deg, rgba(255,255,255,0.035) 0 1px, transparent 1px 4px), repeating-linear-gradient(0deg, rgba(255,255,255,0.035) 0 1px, transparent 1px 4px), repeating-linear-gradient(0deg, rgba(0,0,0,0.20) 0 2px, transparent 2px 6px)",
        "$type": "string"
      }
    }
  },
  "font": {
    "body": {
      "$value": "Noto Sans SC, PingFang SC, sans-serif",
      "$type": "fontFamily"
    },
    "title": {
      "$value": "Georgia, 'Times New Roman', 'Songti SC', serif",
      "$type": "fontFamily"
    },
    "func": {
      "$value": "'Arial Narrow', -apple-system, 'PingFang SC', sans-serif",
      "$type": "fontFamily"
    },
    "number": {
      "$value": "IBM Plex Mono, Menlo, monospace",
      "$type": "fontFamily"
    }
  },
  "light": {
    "pieceSpan": {
      "$value": 14,
      "$type": "number"
    },
    "pieceDy": {
      "$value": 3,
      "$type": "number"
    },
    "pieceAlphaDay": {
      "$value": 0.5,
      "$type": "number"
    },
    "pieceAlphaNight": {
      "$value": 0.22,
      "$type": "number"
    },
    "cellSpan": {
      "$value": 6,
      "$type": "number"
    },
    "cellDy": {
      "$value": 1,
      "$type": "number"
    },
    "cellAlphaDay": {
      "$value": 0.3,
      "$type": "number"
    },
    "cellAlphaNight": {
      "$value": 0.14,
      "$type": "number"
    },
    "nightOverlayMax": {
      "$value": 0.42,
      "$type": "number"
    }
  }
}
