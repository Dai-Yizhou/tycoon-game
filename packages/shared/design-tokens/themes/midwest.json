    "region": {
      "background": {
        "$value": "repeating-linear-gradient(90deg, rgba(42,36,28,0.10) 0 1px, transparent 1px 3px), repeating-linear-gradient(0deg, rgba(42,36,28,0.10) 0 1px, transparent 1px 3px), repeating-linear-gradient(0deg, rgba(255,255,255,0.06) 0 1px, transparent 1px 2px)",
        "$type": "string"
      }
    }
  },
  "font": {
    "body": {
      "$value": "PingFang SC, Microsoft YaHei, Noto Sans SC, sans-serif",
      "$type": "fontFamily"
    },
    "title": {
      "$value": "'Franklin Gothic Medium', 'Arial Black', 'PingFang SC', 'Microsoft YaHei', 'Noto Sans SC', sans-serif",
      "$type": "fontFamily"
    },
    "func": {
      "$value": "'Arial Black', 'Helvetica Neue', Impact, 'Heiti SC', sans-serif",
      "$type": "fontFamily"
    },
    "number": {
