{
  "name": "@game/shared",
  "version": "0.1.0",
  "private": true,
  "description": "共享类型定义与工具库（前后端共用）",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./debug": {
      "types": "./dist/cjs/debug/index.d.ts",
      "import": "./dist/esm/debug/index.js",
      "require": "./dist/cjs/debug/index.js"
    },
    "./map/browser-loader": {
      "types": "./dist/cjs/map/browser-loader.d.ts",
      "import": "./dist/esm/map/browser-loader.js",
      "require": "./dist/cjs/map/browser-loader.js"
    }
  },
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm",
    "build:cjs": "tsc -p tsconfig.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "clean": "rimraf dist coverage *.tsbuildinfo"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.5",
    "typescript": "^5.4.5"
  }
}
